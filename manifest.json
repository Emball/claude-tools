{
  "manifest_version": 3,
  "name": "Claudette",
  "version": "2.6.0",
  "description": "Export Claude.ai chats as Markdown or plain text with images.",
  "permissions": [
    "storage",
    "downloads",
    "webRequest",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["jszip.min.js", "image_classifier.js", "exporter.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ocr_offscreen.html", "ocr_offscreen.js",
        "tesseract.min.js", "worker.min.js",
        "tesseract-core-simd-lstm.wasm.js", "tesseract-core-lstm.wasm.js",
        "exporter.js", "jszip.min.js", "image_classifier.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
